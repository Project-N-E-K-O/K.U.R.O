shader_type canvas_item;

// ============================================================
// 能量球（通用）：程序化生成一颗抖动的发光球体，不依赖贴图。
// 宿主画布建议用**正方形**（ColorRect / Sprite2D 都行），球体大小由 fill 自适应——
// 换尺寸、换颜色、换比例都不用改 shader。
// 想让球体"叠在背景上发光"可以把上一行改成：render_mode blend_add;
// ============================================================


// ============================================================
// 外观
// ============================================================

uniform vec4 outer_color : source_color =
	vec4(0.05, 0.45, 0.08, 1.0);

uniform vec4 inner_color : source_color =
	vec4(0.35, 1.0, 0.25, 1.0);

uniform vec4 core_color : source_color =
	vec4(0.95, 1.0, 0.92, 1.0);


// ============================================================
// 形状
// ============================================================

// 球体横向半径占画布半宽的比例（0.82 ≈ 左右各留 9% 余量，抖动不会被画布裁掉）
uniform float fill : hint_range(0.1, 1.0) = 0.82;

// 椭圆比例：x > y = 横向椭圆
uniform float ellipse_x = 1.30;
uniform float ellipse_y = 0.90;

// 轮廓抖动
uniform float wobble_strength : hint_range(0.0, 0.2) = 0.055;
uniform float wobble_speed = 7.0;

// 轮廓分段数量
uniform float wobble_frequency = 7.0;


// ============================================================
// 内部区域（都是"轮廓半径"的比例）
// ============================================================

uniform float inner_ratio : hint_range(0.0, 1.0) = 0.74;
uniform float core_ratio : hint_range(0.0, 1.0) = 0.36;


// ============================================================
// 边缘柔化（轮廓半径的比例）
// ============================================================

uniform float edge_softness : hint_range(0.0, 1.0) = 0.09;


// ============================================================
// 发光
// ============================================================

uniform float glow_strength : hint_range(0.0, 4.0) = 0.35;


// ============================================================
// Fragment
// ============================================================

void fragment()
{
	// --------------------------------------------------------
	// UV → 中心坐标（画布中心为原点，半宽 = 0.5）
	// --------------------------------------------------------

	vec2 p = UV - vec2(0.5);

	// --------------------------------------------------------
	// 椭圆比例
	// --------------------------------------------------------

	p.x /= ellipse_x;
	p.y /= ellipse_y;

	float r = length(p);

	// --------------------------------------------------------
	// 角度
	// --------------------------------------------------------

	float angle = atan(p.y, p.x);


	// ========================================================
	// 动态抖动（三层不同频率的正弦叠加 = 不规则轮廓）
	// ========================================================

	float wobble =
		sin(angle * wobble_frequency + TIME * wobble_speed) * 0.55 +
		sin(angle * wobble_frequency * 1.73 - TIME * wobble_speed * 1.31) * 0.30 +
		sin(angle * wobble_frequency * 3.21 + TIME * wobble_speed * 0.63) * 0.15;

	wobble *= wobble_strength;


	// --------------------------------------------------------
	// 半径：都相对画布半宽，所以改尺寸 / 改 fill 都不会改变观感
	// --------------------------------------------------------

	float outer_radius = fill * 0.5 / ellipse_x + wobble;
	float inner_radius = outer_radius * inner_ratio + wobble * 0.45;
	float core_radius = outer_radius * core_ratio + wobble * 0.15;

	float soft = outer_radius * edge_softness;


	// ========================================================
	// 外层轮廓
	// ========================================================

	float outer_mask =
		1.0 -
		smoothstep(
			outer_radius - soft,
			outer_radius,
			r
		);


	// ========================================================
	// 浅绿色内部
	// ========================================================

	float inner_mask =
		1.0 -
		smoothstep(
			inner_radius - soft,
			inner_radius,
			r
		);

	inner_mask *= outer_mask;


	// ========================================================
	// 白色核心
	// ========================================================

	float core_mask =
		1.0 -
		smoothstep(
			core_radius - soft,
			core_radius,
			r
		);

	core_mask *= inner_mask;


	// ========================================================
	// 颜色混合
	// ========================================================

	vec3 color =
		outer_color.rgb;

	color =
		mix(
			color,
			inner_color.rgb,
			inner_mask
		);

	color =
		mix(
			color,
			core_color.rgb,
			core_mask
		);


	// ========================================================
	// 内部柔和发光（衰减同样按轮廓半径缩放）
	// ========================================================

	color +=
		inner_color.rgb *
		glow_strength *
		exp(-r / max(outer_radius, 0.0001) * 3.3);


	// ========================================================
	// Alpha
	// ========================================================

	// 乘上"传入的 alpha"（节点 Modulate.a）：这样用 Modulate 做的淡出（FadeOutDuration 之类）才不会被
	// 本 shader 覆盖掉；默认 Modulate = (1,1,1,1) 时没有任何影响。
	COLOR =
		vec4(
			color,
			outer_mask * COLOR.a
		);
}
